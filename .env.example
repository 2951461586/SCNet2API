# ---- 监听 ----
SCNET2API_HOST=127.0.0.1
SCNET2API_PORT=10088

# ---- 管理 ----
# 控制台 / 管理接口口令；非回环监听时必填。
SCNET2API_ADMIN_PASSWORD=
# 允许在无管理密码 / 无网关密钥时监听非回环地址（不安全，仅内网调试）。
SCNET2API_ALLOW_INSECURE=false

# ---- 状态 ----
# 留空 = 用户配置目录（Windows: %APPDATA%\scnet2api\data.json）。
SCNET2API_DATA_PATH=
# 桌面端数据目录；留空自动探测 %APPDATA%\scnet-client。
SCNET2API_CLIENT_DIR=
# 状态文件加密主密钥：openssl rand -hex 32
SCNET2API_MASTER_KEY=

# ---- 账号引导（可选） ----
# 桌面端 config.json 里的 accessToken，可直接登记一个账号。
SCNET_DESKTOP_TOKEN=
# 用账号密码登记一个账号（启动时登录并取 Key；密码随状态文件加密）。
SCNET_USERNAME=
SCNET_PASSWORD=
# 直接导入一个网关密钥。
SCNET2API_API_KEY=

# ---- 上游覆盖（自建 / 测试） ----
# SCNET2API_WEB_ORIGIN=https://www.scnet.cn
# SCNET2API_API_ORIGIN=https://api.scnet.cn/api
# SCNET2API_USER_AGENT=scnet-client/4.1.0
# SCNET2API_CLIENT_VERSION=4.1.0
